# Anthropic — the only paid service in this project (CLAUDE.md C1/C2)
ANTHROPIC_API_KEY=

# Postgres — used by docker-compose.yml; nothing connects to it yet in Phase 0
POSTGRES_USER=agentinvest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentinvest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Logging
LOG_LEVEL=INFO

# SEC/EDGAR — required, no code-level default. This is sent as the
# User-Agent on every SEC request and given to edgartools' set_identity().
# SEC's own guidance: "Sample Company Name AdminContact@sample.com" style.
# NEVER put a real email in this committed file — fill in your own in .env.
EDGAR_IDENTITY="Your Name your.email@example.com"

# FRED — free, self-serve key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Data layer cache — local SQLite this phase (NOT the Postgres `cache`
# table from CLAUDE.md §14; that migrates once backend/db/ is built for
# real, likely Phase 2).
DATA_CACHE_PATH=./data/cache.sqlite3
