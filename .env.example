# Anthropic — the only paid service in this project (CLAUDE.md C1/C2)
ANTHROPIC_API_KEY=

# Postgres — as of Phase 3, backend/db/ (SQLAlchemy async + Alembic) uses
# this via Settings.postgres_async_dsn. Two options, pick one:
#
# 1. docker-compose.yml's local pgvector/pgvector:pg16 container (values
#    below match its defaults) — needs Docker running locally.
# 2. A Supabase project's DIRECT connection string (Project Settings ->
#    Database -> Connection string -> "URI", NOT the pooled/PgBouncer
#    one — Alembic's DDL needs the direct, session-mode connection, and
#    this project deliberately uses that single connection for the app's
#    own runtime queries too rather than a separate pooled DSN; see
#    ADR-0013). It looks like:
#    POSTGRES_HOST=db.<your-project-ref>.supabase.co
#    POSTGRES_PORT=5432
#    POSTGRES_USER=postgres
#    POSTGRES_PASSWORD=<your project's database password>
#    POSTGRES_DB=postgres
#    Confirm the `vector` extension is enabled for your project before
#    running `uv run alembic upgrade head` (Database -> Extensions).
POSTGRES_USER=agentinvest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentinvest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Logging
LOG_LEVEL=INFO

# SEC/EDGAR — required, no code-level default. This is sent as the
# User-Agent on every SEC request and given to edgartools' set_identity().
# SEC's own guidance: "Sample Company Name AdminContact@sample.com" style.
# NEVER put a real email in this committed file — fill in your own in .env.
EDGAR_IDENTITY="Your Name your.email@example.com"

# FRED — free, self-serve key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Data layer cache — local SQLite this phase (NOT the Postgres `cache`
# table from CLAUDE.md §14; that migrates once backend/db/ is built for
# real, likely Phase 2).
DATA_CACHE_PATH=./data/cache.sqlite3
